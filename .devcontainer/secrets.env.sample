# Copy to .devcontainer/secrets.env and fill in. NEVER commit secrets.env.
# Loaded into the container with `docker --env-file`, so:
#   - one KEY=VALUE per line, no `export`, no quotes (quotes become part of the value)
#   - no variable expansion, no inline comments after a value

# --- Claude Code -------------------------------------------------------------
# Long-lived token from `claude setup-token` (Pro/Max plans).
CLAUDE_CODE_OAUTH_TOKEN=

# Or, for API-key billing instead of a plan, set this and leave the token empty.
ANTHROPIC_API_KEY=

# --- GitHub ------------------------------------------------------------------
# Fine-grained or classic PAT. Used by the gh CLI and git over HTTPS.
GITHUB_TOKEN=
# Some tooling reads GH_TOKEN instead — keep both in sync.
GH_TOKEN=
